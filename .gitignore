.eslintcache
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
/.netlify/

# Local editor state
/.idea/
/.vscode/*
!/.vscode/extensions.json
/.notes*
*.sw?
