{
  "name": "v-calendar-3",
  "type": "module",
  "version": "1.0.1",
  "description": "A calendar and date picker plugin for Vue 3.",
  "author": "ujidesu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BEJIbXEOP/v-calendar.git"
  },
  "homepage": "https://vcalendar.io",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.js",
  "jsdelivr": "dist/iife/index.js",
  "unpkg": "dist/iife/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "plugin",
    "calendar",
    "v-calendar",
    "datepicker",
    "date picker"
  ],
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "node": "./dist/mjs/index.mjs",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./style.css": "./dist/style.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsx build/build.ts",
    "build:docs": "cd docs && yarn build",
    "build:all": "yarn build && yarn build:docs",
    "dev": "vite --host 127.0.0.1",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "check:package": "publint && attw --pack . --ignore-rules no-resolution",
    "validate": "npm run lint && npm run typecheck && npm run test:unit && npm run test:browser && npm run build && npm run check:package"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lodash": "^4.18.1"
  },
  "peerDependencies": {
    "@popperjs/core": "^2.11.8",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@popperjs/core": "^2.11.8",
    "@types/lodash": "^4.17.24",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.39",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "postcss-import": "^16.1.1",
    "postcss-nested": "^7.0.2",
    "prettier": "^3.9.5",
    "publint": "^0.3.21",
    "rollup-plugin-visualizer": "^7.0.1",
    "rollup-plugin-dts": "^6.4.1",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "browserslist": [
    "> 0.5%",
    "not dead",
    "not op_mini all"
  ]
}
