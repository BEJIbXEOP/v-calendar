{
  "name": "v-calendar-fixed",
  "type": "module",
  "version": "3.1.9",
  "description": "A calendar and date picker plugin for Vue.js. fixed by BEJIbXEOP",
  "author": "BEJIbXEOP <lexsystemscorp@gmail.com>",
  "repository": "https://github.com/BEJIbXEOP/v-calendar",
  "homepage": "https://vcalendar.io",
  "main": "dist/cjs/index.js",
  "module": "dist/es/index.js",
  "jsdelivr": "dist/iife/index.js",
  "unpkg": "dist/iife/index.js",
  "types": "dist/types/src/index.d.ts",
  "keywords": [
    "vue",
    "vue3",
    "vuejs",
    "plugin",
    "calendar",
    "v-calendar",
    "datepicker",
    "date picker"
  ],
  "license": "MIT",
  "files": [
    "src",
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": {
        "node": "./dist/mjs/index.mjs",
        "default": "./dist/es/index.js"
      },
      "require": "./dist/cjs/index.js"
    },
    "./style.css": "./dist/style.css",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsx build/build.ts",
    "build:docs": "cd docs && yarn build",
    "build:all": "yarn build && yarn build:docs",
    "test": "vitest",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,vue}\""
  },
  "dependencies": {
    "@types/lodash": "^4.17.20",
    "@types/resize-observer-browser": "^0.1.11",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "lodash": "^4.17.21",
    "vue-screen-utils": "1.0.0-beta.13"
  },
  "peerDependencies": {
    "@popperjs/core": "^2.11.8",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/compiler-sfc": "^3.2.0",
    "@vue/test-utils": "^2.3.2",
    "autoprefixer": "^9.7.8",
    "jsdom": "^21.1.1",
    "postcss": "^8.0.0",
    "postcss-import": "^14.0.2",
    "postcss-inline-svg": "^4.1.0",
    "postcss-nested": "^4.2.1",
    "postcss-simple-vars": "5.0.2",
    "postcss-url": "^8.0.0",
    "regenerator-runtime": "^0.13.9",
    "resize-observer-polyfill": "^1.5.1",
    "rollup-plugin-visualizer": "^5.5.4",
    "terser": "^5.16.1",
    "tslib": "^2.4.0",
    "tsx": "^3.12.2",
    "typescript": "^4.8.4",
    "vite": "^5.4.21",
    "vitest": "^0.29.7",
    "vue": "^3.5.16",
    "vue-tsc": "^1.0.24"
  }
}
